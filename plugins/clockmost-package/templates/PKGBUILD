# Maintainer: <you> <email>
# Template — builds from the pushed git tag, so this file works in CI and for
# a plain `makepkg -si`. Replace the <...> bits.

pkgname=<name>
pkgver=0.1.0
pkgrel=1
pkgdesc="<one line>"
arch=('x86_64')
url="https://git.clockmost.com/pkgs/${pkgname}"
license=('GPL-3.0-only')
depends=(
  # first guess — tighten from the CI `namcap` report on the first release
  'gcc-libs' 'glibc'
)
makedepends=('rust' 'cargo' 'git' 'pkgconf' 'mold')
options=('!lto')
source=("git+${url}.git#tag=v${pkgver}")
b2sums=('SKIP')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTFLAGS="-C link-arg=-fuse-ld=mold ${RUSTFLAGS:-}"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname"
  cargo test --frozen --release --all-features || true
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  [ -f README.md ] && install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
